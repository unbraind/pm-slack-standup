tests[2]:
  - command: npm run coverage
    path: test/fetch-all-items.test.ts
    scope: project
    note: fetchAllItems throws non-zero status with stderr
  - command: npx tsx --test test/smoke.test.ts test/fetch-all-items.test.ts
    scope: project
    timeout_seconds: 300
    assert_stdout_contains[1]: the preflight scope covers every registered command path
    assert_stdout_regex[1]: fail 0$
    note: "Covers the preflight ownership scope derived from real activation and the non-array items refusal. Non-vacuous: reverting either fix fails (verified 2026-08-15)."
