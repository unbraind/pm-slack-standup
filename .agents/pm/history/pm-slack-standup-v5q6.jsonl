{"ts":"2026-08-13T21:19:05.261Z","author":"codex","author_source":"configured","agent_harness":"claude-code","agent_instance":"2a00cb64a3a7c61d1591525b","agent_provenance":{"model":null,"effort":{"value":"xhigh","source":"environment"},"role":{"value":"implementer","source":"argv"},"topic":null},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"pm-slack-standup-v5q6"},{"op":"add","path":"/metadata/title","value":"Declaring the pm CLI as a runtime dependency gives consumers a second nested copy whenever their host pin differs"},{"op":"add","path":"/metadata/description","value":"This package declared @unbrained/pm-cli in both dependencies and peerDependencies. The two ranges were separately satisfiable, so npm resolved them independently rather than treating the host copy as the one that counts: a consumer whose host pin sits below the dependency range while still inside the declared peer range receives their copy at the tree root plus a second, newer copy nested under this package. npm dedupes only when the ranges happen to overlap, so the tree is clean for some host pins and skewed for others. Skew matters because consecutive CLI releases disagree about whether identical history bytes are fatal, a warning, or invisible, so which copy loads can decide a workspace gate verdict. This package is a pure extension with no bin entry, and sixteen sibling packages import the same SDK at runtime while declaring the CLI only as a peer plus dev dependency."},{"op":"add","path":"/metadata/type","value":"Issue"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":1},{"op":"add","path":"/metadata/tags","value":["correctness","packaging"]},{"op":"add","path":"/metadata/created_at","value":"2026-08-13T21:19:05.261Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-08-13T21:19:05.261Z"},{"op":"add","path":"/metadata/author","value":"codex"}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"fd0d9831aa950d1724012c7e2a55ce2ce7e1a43f9cf9b18ee6a731d1c69928e5","item_hash_version":2,"message":"","context":{"agent_provenance_outcomes":{"model":{"status":"failed","reason":"resolver_failed","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"failed","reason":"resolver_failed","resolver":"claude_session_file","rule_version":"v1"}}}}
