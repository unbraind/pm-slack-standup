{"ts":"2026-09-05T18:03:51.515Z","author":"claude-orchestrator","author_source":"asserted","agent_harness":"claude-code","agent_instance":"d8dbc6c3b8a673148b5c3e78","agent_provenance":{"model":null,"effort":{"value":"xhigh","source":"environment"},"role":{"value":"implementer","source":"argv"},"topic":null},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"pm-slack-standup-lvgk"},{"op":"add","path":"/metadata/title","value":"Refuse a line break in a cmd.exe launch argument, which quoting cannot contain"},{"op":"add","path":"/metadata/description","value":"quoteWindowsArg only quotes an argument containing one of tab, space, double quote, ampersand, pipe, angle bracket, parenthesis or caret, and the existing refusal covers only percent-delimited names. A carriage return or line feed is in neither set, so it reached the cmd tail unquoted, and cmd ends the command at a line break and reads the remainder as a separate command."},{"op":"add","path":"/metadata/type","value":"Issue"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":2},{"op":"add","path":"/metadata/tags","value":[]},{"op":"add","path":"/metadata/created_at","value":"2026-09-05T18:03:51.515Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-09-05T18:03:51.515Z"},{"op":"add","path":"/metadata/author","value":"claude-orchestrator"}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"931d382fbd7f7cb35d8eb239a5ba1246d848d259e8dc0295eab4ede2cd913e38","item_hash_version":3,"message":"","context":{"agent_provenance_outcomes":{"model":{"status":"failed","reason":"resolver_failed","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"failed","reason":"resolver_failed","resolver":"claude_session_file","rule_version":"v1"}}}}
