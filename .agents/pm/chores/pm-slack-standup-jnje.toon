    scope: project
    timeout_seconds: 600
    pm_context_mode: schema
    workspace_context_mode: source
    provenance:
      author: codex-agent
      created_at: "2026-10-26T18:37:56.360Z"
      source_kind: local_mutation
  - command: "bun run release:check"
    scope: project
    timeout_seconds: 10800
    provenance:
      author: codex-agent
      created_at: "2026-10-26T18:41:52.070Z"
      source_kind: local_mutation
docs[1]{path,scope}:
